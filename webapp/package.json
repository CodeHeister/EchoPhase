{
  "name": "webapp",
  "version": "1.0.0",
  "description": "EchoPhase webapp",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "analyze": "vite build --mode analyze",
    "format": "prettier --write .",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "gen:lib": "tsx scripts/generate-lib-indexes.ts",
    "gen:api": "openapi-typescript ${OPENAPI:-../artifacts/openapi.json} -o src/lib/api/schema.d.ts && prettier --write src/lib/api/schema.d.ts",
    "check:api": "npm run gen:api && git diff --exit-code -- src/lib/api/schema.d.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "encoding": "^0.1.13",
    "eslint": "^10.12.0",
    "eslint-plugin-solid": "^0.18.1",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "rollup-plugin-visualizer": "^7.1.1",
    "sass-embedded": "^1.105.1",
    "solid-refresh": "^0.7.8",
    "terser": "^5.51.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-sitemap": "^0.8.2",
    "vite-plugin-solid": "^2.11.14",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/ed25519": "^3.2.0",
    "@noble/hashes": "^2.4.0",
    "@solidjs/meta": "^0.29.4",
    "@solidjs/router": "^1.0.0",
    "browser-headers": "^0.4.1",
    "earcut": "^3.2.4",
    "material-icons": "^1.13.14",
    "material-symbols": "^0.48.0",
    "msgpackr": "^2.1.0",
    "opentype.js": "^2.0.0",
    "solid-icons": "^1.2.0",
    "solid-js": "^1.9.17"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "esbuild": false,
    "msgpackr-extract": false
  }
}
